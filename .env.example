# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Models
STICKER_IMAGE_MODEL=gpt-image-2.5-sunburst
STICKER_GIF_MODEL=gpt-image-2.6-sunburst

# Performance & Retries
STICKER_MAX_RETRIES=2
STICKER_MAX_PARALLEL=2

# Font configuration
# Provide a path to a licensed Chinese TTF/OTF/TTC font.
# On macOS, e.g. /System/Library/Fonts/STHeiti Medium.ttc or /System/Library/Fonts/Supplemental/Songti.ttc
STICKER_FONT_PATH=

# Logging
STICKER_LOG_LEVEL=INFO
